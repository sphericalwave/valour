# Copy to .env to switch the app from seeded local data to a real Supabase project.
# Leave BOTH unset and the app runs entirely on in-browser seed data (default demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base path for GitHub Pages. Defaults to "/valour/". Set "/" for a user page or custom domain.
# VITE_BASE=/valour/
